#!name=NodeSeek
#!desc=NodeSeek 每日签到，支持固定 5 鸡腿或随机签到。SignMode=fixed 为固定，SignMode=random 为随机。
#!author=Sliverkiss Modified
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/NodeSeek.png
#!homepage=https://www.nodeseek.com/
#!date=2026-04-01
#!arguments=SignMode:"fixed",Cron:"0 9 * * *"

[Script]
NodeSeek 获取 Token = type=http-response,pattern=^https:\/\/www\.nodeseek\.com\/api\/account\/getInfo\/.+\?readme=1&signature=1&phone=1,requires-body=1,timeout=60,script-path=https://你的脚本地址/nodeseek.js

NodeSeek 每日签到 = type=cron,cronexp="{{{Cron}}}",timeout=60,script-path=https://你的脚本地址/nodeseek.js,argument=signMode={{{SignMode}}}

[MITM]
hostname = %APPEND% www.nodeseek.com
